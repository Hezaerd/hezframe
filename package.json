{
  "name": "hezframe",
  "version": "0.6.2",
  "private": true,
  "description": "A quiet Samsung TV home screen, adapted from CleanFrame.",
  "scripts": {
    "dev": "python scripts/preview.py",
    "check": "node --check app/main.js && node --check app/device.js && python scripts/check.py",
    "package": "python scripts/package.py",
    "tv:info": "python scripts/tv.py info",
    "tv:install": "python scripts/tv.py install",
    "tv:launch": "python scripts/tv.py launch",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:public": "python scripts/preview.py --public-fonts",
    "export:public": "python scripts/export-public.py",
    "check:public": "python scripts/check-public.py",
    "check:hezframe": "node scripts/check-hezframe.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "license": "MIT"
}
